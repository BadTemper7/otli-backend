{
  "name": "hostinger-test-api",
  "version": "1.0.0",
  "description": "Flat Hostinger test server with One True Logistics backend",
  "main": "server.js",
  "engines": {
    "node": ">=20 <25",
    "npm": ">=10"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seed/seedSuperAdmin.js",
    "backfill:release-reports": "node seed/backfillReleaseReports.js",
    "test": "vitest run",
    "test:offline": "node --test tests/*.node.test.js",
    "email:simulate": "node scripts/simulateEmailLoad.js",
    "email:dns": "node scripts/checkEmailDns.js",
    "email:worker": "node scripts/emailWorker.js",
    "email:indexes": "node scripts/createEmailIndexes.js",
    "test:integration": "node --test tests/emailIntegration.node.test.js",
    "email:staging-load": "node scripts/stageEmailQueue.js"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "express-rate-limit": "7.5.0",
    "helmet": "7.2.0",
    "jsonwebtoken": "9.0.2",
    "mongoose": "8.9.2",
    "morgan": "1.10.0",
    "multer": "1.4.5-lts.1",
    "nodemailer": "6.9.16",
    "socket.io": "4.8.1",
    "bullmq": "^5.81.5",
    "ioredis": "^5.9.3"
  },
  "devDependencies": {
    "nodemon": "3.1.9",
    "vitest": "^4.0.0"
  }
}
